---
/**
 * The one layout. Every page's <head>, top bar and footer live here, which is
 * the whole reason for moving to Astro: the CSS exists once instead of being
 * duplicated into a generated file and policed by a byte-equality test.
 *
 * The stylesheet is imported, not pasted. astro.config.mjs sets
 * `build.inlineStylesheets: 'always'`, so Astro inlines it into <head> at build
 * time — the deployed page is still one self-contained file with zero external
 * requests, which is the property that actually matters (see handoff §2).
 */
import '../styles/site.css';
import favicon from '../data/favicon.txt?raw';
import videos from '../data/videos.json';

export interface Props {
  title: string;
  description: string;
  path: string;              // "/", "/writing/", "/writing/<id>/"
  ogType?: string;
  jsonLd?: unknown;
  showWatching?: boolean;    // the rotating video line — home page only
  current?: string;          // nav pillar to mark aria-current
}

const {
  title,
  description,
  path,
  ogType = 'website',
  jsonLd,
  showWatching = false,
  current,
} = Astro.props;

const SITE = 'https://kylecovan.com';
const canonical = `${SITE}${path}`;

/* Three pillars: his name (home), In Your Sight, Contact.

   August 24, 2026: Upon the Waters became In Your Sight; Psalm 19:14
   replaced Ecclesiastes 11:1 on /writing/ (verse sits under the h1). URL
   stays /writing/.

   August 24, 2026 (earlier): Unless the Lord became Upon the Waters.

   August 21, 2026: Builds left the nav. Old /builds/ URLs redirect into
   the house. Privacy stays in the footer.

   July 30 history, still true: Story left because it pointed at an anchor on
   the page you are already standing on, while nothing in the nav said "home."
   His name does that job. #story stays, so /#story still works. Approach left
   because its 109 words became a post. Contact is the one remaining in-page
   anchor, and off the home page it has to become an absolute path. */
const onHome = path === '/';
const nav = [
  { label: 'Kyle Covan', href: '/' },
  { label: 'In Your Sight', href: '/writing/' },
  { label: 'Contact',    href: onHome ? '#contact' : '/#contact' },
];

/* Entry 01 is the no-JS fallback, hardcoded exactly as it was in the hand-built
   version. The script below swaps in a random pick during parse, before first
   paint, so there is no flash of the default. */
const fallback = videos[0];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="Kyle Covan">
<meta name="theme-color" content="#FBF8F2">
<link rel="canonical" href={canonical}>

<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={`${SITE}/og-2.png`}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Kyle Covan — striving to put Jesus Christ first — AI Builder, Strategist, and Partner">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={`${SITE}/og-2.png`}>

<link rel="alternate" type="application/rss+xml" title="Kyle Covan — In Your Sight" href={`${SITE}/rss.xml`}>

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />
)}

<link rel="icon" type="image/png" sizes="any" href={favicon}>
</head>

<body>
<div class="page">
  <main>

    <div class="topbar">
      <nav class="topnav" aria-label="Sections">
        {nav.map(item => (
          <a href={item.href} aria-current={current === item.label ? 'page' : undefined}>
            {item.html ? <Fragment set:html={item.html} /> : item.label}
          </a>
        ))}
      </nav>
      {showWatching && (
        <p class="watching">
          {/* The trailing label does two jobs. It names the destination, which
              this row never did: it was a bare sentence in the top bar with
              nothing to say it was a link at all, let alone one leaving the
              site. And it frames the title as SOMEONE ELSE'S video that Kyle
              saved, not as Kyle's own words. "Going Against the Stream on
              YouTube" read as a boast about him rather than the title of a
              sermon he was watching, and any title in the list can be misread
              that way. "from my YouTube watch list" fixes the whole list at
              once instead of pruning titles one by one.

              A COLON, and a LOWERCASE "from". The colon is Kyle's call over the
              comma. Lowercase is the same rule that governs every other colon
              on this site: a capital follows a colon only before a complete
              sentence or a direct question, and "from my liked videos on
              YouTube" is a fragment. Compare `.epigraph-cite` and the
              one-liners, which are lowercase after their colons for the same
              reason.

              Wording is the literal truth, checked with him rather than
              assumed: these are the videos he pressed Like on, so the line says
              that. "Watch list" was drafted first as the safest hedge, on the
              grounds that "liked" would claim a YouTube feature he might not
              have used. He confirmed he had. The specific claim is better than
              the safe one when the specific claim is true.

              THE LABEL MUST FOLLOW THE LINK, NOT PRECEDE IT. Written as a
              "Watching on YouTube:" prefix first, and verify.py rejected it at
              all five widths: the assertion measures the ANCHOR's left edge,
              and a prefix pushed it 145px inboard, off the column edge that
              every heading below shares. That is §3's left-edge rule, and the
              test was right. Trailing text leaves the link flush left.

              The inline script below replaces only the anchor's text, so this
              suffix survives the random swap. */}
          <a id="watching-link"
             href={fallback.url}
             target="_blank"
             rel="noopener noreferrer">{fallback.title}</a>: from my liked videos on YouTube
        </p>
      )}
    </div>

    {showWatching && (
      <script is:inline set:html={`
      (function () {
        "use strict";
        var VIDEOS = ${JSON.stringify(videos)};
        var link = document.getElementById("watching-link");
        if (!link || !VIDEOS.length) return;
        var pick = VIDEOS[Math.floor(Math.random() * VIDEOS.length)];
        link.textContent = pick.title;
        link.setAttribute("href", pick.url);
      }());`} />
    )}

    <slot />

  </main>

  <footer class="colophon">
    {/* Privacy sits in the footer, not the nav. The nav is three pillars;
        a privacy policy is plumbing, and the footer is where a reader looks
        for it. */}
    <p>© <span>2026</span> Kyle Covan · <a href="/privacy/">Privacy</a></p>
    <p class="credit">Built in partnership with
      <a href="https://avatar.andrewng.org" target="_blank" rel="noopener noreferrer">AI Andrew Ng</a></p>
  </footer>
</div>
</body>
</html>
