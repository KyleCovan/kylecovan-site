---
/**
 * The one layout. Every page's <head>, top bar and footer live here, which is
 * the whole reason for moving to Astro: the CSS exists once instead of being
 * duplicated into a generated file and policed by a byte-equality test.
 *
 * The stylesheet is imported, not pasted. astro.config.mjs sets
 * `build.inlineStylesheets: 'always'`, so Astro inlines it into <head> at build
 * time — the deployed page is still one self-contained file with zero external
 * requests, which is the property that actually matters (see handoff §2).
 */
import '../styles/site.css';
import favicon from '../data/favicon.txt?raw';
import videos from '../data/videos.json';

export interface Props {
  title: string;
  description: string;
  path: string;              // "/", "/builds/", "/builds/<id>/"
  ogType?: string;
  jsonLd?: unknown;
  showWatching?: boolean;    // the rotating video line — home page only
  current?: string;          // nav pillar to mark aria-current
}

const {
  title,
  description,
  path,
  ogType = 'website',
  jsonLd,
  showWatching = false,
  current,
} = Astro.props;

const SITE = 'https://kylecovan.com';
const canonical = `${SITE}${path}`;

/* Rebuilt July 30. Was Story · Approach · Building · Contact.

   Story left the nav because Kyle spotted that it pointed at an anchor on the
   page you are already standing on — a scroll-to-here, not a destination —
   while nothing in the nav said "home" at all. The only way back was a text
   link at the very bottom of the page. His name now does that job, and the
   site gets the wordmark it never had. #story stays in the HTML, so any
   existing /#story deep link still works.

   Approach left because its 109 words became a post; see
   src/content/writing/startup-operations-now-ai-orchestration.md.

   Every pillar is now a real destination. Contact is the one remaining anchor,
   and off the home page it has to become an absolute path or it would look for
   #contact on a page that has no Contact section. */
const onHome = path === '/';
const nav = [
  { label: 'Kyle Covan', href: '/' },
  { label: 'Builds',     href: '/builds/' },
  /* The divine name in small caps, as every major English translation sets it.
     Only "ord" is wrapped, so the text stays "Unless the Lord" for copy/paste
     and screen readers. See the .sc note in site.css. */
  { label: 'Unless the Lord', href: '/writing/',
    html: 'Unless the L<span class="sc">ord</span>' },
  { label: 'Contact',    href: onHome ? '#contact' : '/#contact' },
];

/* Entry 01 is the no-JS fallback, hardcoded exactly as it was in the hand-built
   version. The script below swaps in a random pick during parse, before first
   paint, so there is no flash of the default. */
const fallback = videos[0];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="Kyle Covan">
<meta name="theme-color" content="#FBF8F2">
<link rel="canonical" href={canonical}>

<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={`${SITE}/og.png`}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Kyle Covan — striving to put Jesus Christ first — AI Builder, Strategist, and Partner">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={`${SITE}/og.png`}>

<link rel="alternate" type="application/rss+xml" title="Kyle Covan — Building in public" href={`${SITE}/rss.xml`}>

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />
)}

<link rel="icon" type="image/png" sizes="any" href={favicon}>
</head>

<body>
<div class="page">
  <main>

    <div class="topbar">
      <nav class="topnav" aria-label="Sections">
        {nav.map(item => (
          <a href={item.href} aria-current={current === item.label ? 'page' : undefined}>
            {item.html ? <Fragment set:html={item.html} /> : item.label}
          </a>
        ))}
      </nav>
      {showWatching && (
        <p class="watching">
          {/* "on YouTube" names the destination, which this row never did: it
              was a bare sentence in the top bar with nothing to say it was a
              link at all, let alone one leaving the site.

              THE LABEL MUST FOLLOW THE LINK, NOT PRECEDE IT. Written as a
              "Watching on YouTube:" prefix first, and verify.py rejected it at
              all five widths: the assertion measures the ANCHOR's left edge,
              and a prefix pushed it 145px inboard, off the column edge that
              every heading below shares. That is §3's left-edge rule, and the
              test was right. Trailing text leaves the link flush left.

              The inline script below replaces only the anchor's text, so this
              suffix survives the random swap. */}
          <a id="watching-link"
             href={fallback.url}
             target="_blank"
             rel="noopener noreferrer">{fallback.title}</a> on YouTube
        </p>
      )}
    </div>

    {showWatching && (
      <script is:inline set:html={`
      (function () {
        "use strict";
        var VIDEOS = ${JSON.stringify(videos)};
        var link = document.getElementById("watching-link");
        if (!link || !VIDEOS.length) return;
        var pick = VIDEOS[Math.floor(Math.random() * VIDEOS.length)];
        link.textContent = pick.title;
        link.setAttribute("href", pick.url);
      }());`} />
    )}

    <slot />

  </main>

  <footer class="colophon">
    <p>© <span>2026</span> Kyle Covan</p>
    <p class="credit">Built in partnership with
      <a href="https://avatar.andrewng.org" target="_blank" rel="noopener noreferrer">AI Andrew Ng</a></p>
  </footer>
</div>
</body>
</html>
