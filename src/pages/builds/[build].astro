---
/**
 * One page per build. Prose about the thing, then everything dated that is
 * tagged to it.
 *
 * THIS IS A PILLAR PAGE and the shape is deliberate. handoff §1 settled that
 * generative engines work at the passage level and reward one document that
 * answers a topic's sub-questions, rather than one-topic-per-URL silos. So a
 * build's description AND every post about it live here together, in full.
 * Moving that writing onto separate /writing/ URLs was considered on July 30
 * and rejected: it reads worse (a reader has to click away for the story), it
 * ranks worse, and it makes an AI reassemble the topic from fragments.
 *
 * The old `outline` list is gone from the render. It published five bullets of
 * "What the log will cover" on a page with nothing behind them — promises, not
 * content. Those bullets are now writing prompts in the build's frontmatter,
 * which Kyle answers in prose. Don't render `prompts`.
 */
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const builds = await getCollection('builds');
  return builds.map(build => ({ params: { build: build.id }, props: { build } }));
}) satisfies GetStaticPaths;

const { build } = Astro.props;
const { Content } = await render(build);

/* Astro's `reference()` resolves to { collection, id }. `build` is optional on
   a writing entry, so the ?. is load-bearing — an untagged essay would throw. */
const entries = (await getCollection('writing', ({ data }) => !data.draft))
  .filter(e => e.data.build?.id === build.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rendered = await Promise.all(
  entries.map(async (e) => ({ entry: e, Content: (await render(e)).Content }))
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);

const label = `Project ${String(build.data.order).padStart(2, '0')}`;
const url = `https://kylecovan.com/builds/${build.id}/`;

const title = `${build.data.name} — Kyle Covan`;
/* Descriptions must be unique per page (verify_site.py check 2). The one-liner
   is already unique per build, so it does that work without a second string to
   keep in sync with it.

   `description` OVERRIDES it, and only when a build actually sets one. Added
   August 6 because `oneLiner` was being asked to do two jobs with one length
   budget. It is VISIBLE COPY — the `.lede` on this page and the `.one-liner` on
   both the home page and /builds/ — and it is Kyle's words, which section 6 puts
   out of reach. It is ALSO the `<meta name="description">` and, through
   `Base.astro`, the `og:description` share card, where anything past roughly 155
   characters is cut mid-sentence. Personal AI OS's runs 210.

   Those two jobs disagree, so the fix is a second field rather than a shorter
   sentence: the page keeps saying what Kyle wrote, and the search result and the
   share card get a string written for that budget. Every build is currently
   unset and therefore unchanged. */
const description = build.data.description ?? build.data.oneLiner;

/* Structured data is derived from the same collection the page renders from, so
   the markup cannot claim a headline or a date the page doesn't show. That is
   schema.org's rule and Google penalises breaking it; generating both from one
   source is the cheapest way to keep it true permanently. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': `${url}#blog`,
      url,
      name: build.data.name,
      /* The same const the <meta> uses, not a second copy of the text. A
         separately-worded JSON-LD description was removed from /builds/ for
         exactly this reason: it is one more string that drifts with nothing
         testing it. */
      description,
      inLanguage: 'en',
      author: { '@id': 'https://kylecovan.com/#kyle' },
      publisher: { '@id': 'https://kylecovan.com/#kyle' },
      ...(entries.length
        ? {
            blogPost: entries.map(e => ({
              '@type': 'BlogPosting',
              headline: e.data.title,
              datePublished: iso(e.data.date),
              url: `${url}#${e.id}`,
              author: { '@id': 'https://kylecovan.com/#kyle' },
              about: build.data.name,
              isPartOf: { '@id': `${url}#blog` },
            })),
          }
        : {}),
    },
    {
      '@type': 'Person',
      '@id': 'https://kylecovan.com/#kyle',
      name: 'Kyle Covan',
      url: 'https://kylecovan.com/',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kyle Covan', item: 'https://kylecovan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Builds', item: 'https://kylecovan.com/builds/' },
        { '@type': 'ListItem', position: 3, name: build.data.name, item: url },
      ],
    },
  ],
};
---
<Base
  title={title}
  description={description}
  path={`/builds/${build.id}/`}
  ogType="article"
  current="Builds"
  jsonLd={jsonLd}
>

  <header class="masthead-page">
    <p class="eyebrow">{label}</p>
    <h1>{build.data.name}</h1>
    <p class="lede">{build.data.oneLiner}</p>
  </header>

  {/* The prose — the thing itself. EMPTY on both builds today: it is Kyle's to
      write and §6 forbids drafting it on his behalf. An empty body renders
      nothing at all, so the page degrades to heading + one-liner + log rather
      than to a broken layout. The prompts to answer are in the build's
      frontmatter. */}
  <Content />

  {rendered.length > 0 ? (
    <>
      <p class="log-label">Build log</p>
      {rendered.map(({ entry, Content: EntryBody }) => (
        /* h2 here because this page's own h1 is the build name, so entries move
           up a level to keep h1 -> h2 unbroken. That is exactly why the styling
           hangs off .entry-title rather than a tag selector. */
        <article class="entry" id={entry.id}>
          <p class="entry-date">{fmt(entry.data.date)}</p>
          <h2 class="entry-title">{entry.data.title}</h2>
          <EntryBody />
        </article>
      ))}
    </>
  ) : (
    <p class="log-status">Build log — first entry coming soon.</p>
  )}

  <p class="follow-label">Follow along</p>
  <p class="socials">
    <a href="/rss.xml">RSS</a><span class="sep" aria-hidden="true">&#183;</span
    ><a href="https://www.youtube.com/@KyleCovan" rel="me">YouTube</a><span class="sep" aria-hidden="true">&#183;</span
    ><a href="https://x.com/kylecovan" rel="me">X</a><span class="sep" aria-hidden="true">&#183;</span
    ><a href="https://www.linkedin.com/in/kylecovan/" rel="me">LinkedIn</a>
  </p>

  <p class="more"><a href="/builds/">All builds</a></p>

</Base>
