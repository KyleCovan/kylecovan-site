---
/**
 * The writing index. Nav label "In Your Sight", URL /writing/.
 *
 * The house. Every published post in one stream. Every item links to its
 * own /writing/<id>/. No log/essay visual split — August 24, 2026.
 *
 * The label is expressive and the URL is plain, on purpose: URLs are functional
 * and a person typing one guesses "writing", not a psalm. The name does its
 * work where a name should, on the page.
 */
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const builds = await getCollection('builds');

/* Old /building/#<id> and /builds/#<id> fragments. The server never sees a
   hash, so a 301 to this page only works if the id still exists here. */
const fragmentIds = builds.map((b) => b.id);

const items = posts.map((p) => ({
  post: p,
  href: `/writing/${p.id}/`,
}));

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const title = 'In Your Sight — Kyle Covan';
const description =
  'Writing by Kyle Covan on faith, technology, and the daily striving.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://kylecovan.com/writing/#page',
      url: 'https://kylecovan.com/writing/',
      name: 'In Your Sight',
      description: 'Writing on faith, technology, and the daily striving.',
      inLanguage: 'en',
      author: { '@id': 'https://kylecovan.com/#kyle' },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: items.map((it, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: it.post.data.title,
          url: `https://kylecovan.com${it.href}`,
        })),
      },
    },
    {
      '@type': 'Person',
      '@id': 'https://kylecovan.com/#kyle',
      name: 'Kyle Covan',
      url: 'https://kylecovan.com/',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://kylecovan.com/writing/#breadcrumbs',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kyle Covan', item: 'https://kylecovan.com/' },
        { '@type': 'ListItem', position: 2, name: 'In Your Sight', item: 'https://kylecovan.com/writing/' },
      ],
    },
  ],
};
---
<Base
  title={title}
  description={description}
  path="/writing/"
  current="In Your Sight"
  jsonLd={jsonLd}
>

  {/* Psalm 19:14 — directly under the h1, not as it. The verse is NOT the h1;
      see the .epigraph note in site.css. August 24, 2026: replaced
      Ecclesiastes 11:1 when the house was renamed In Your Sight. */}
  <header class="masthead-page">
    <h1>In Your Sight</h1>
    <p class="epigraph">
      Let the words of my mouth and the meditation of my heart<br />
      be acceptable in your sight,<br />
      O L<span class="sc">ord</span>, my rock and my redeemer.
    </p>
    <p class="epigraph-cite">Psalm 19:14, ESV</p>
  </header>

  {/* Silent targets for published /building/# and /builds/# deep links.
      No copy. The house is the landing. */}
  {fragmentIds.map((id) => (
    <span id={id} class="fragment-target"></span>
  ))}

  {items.length > 0 ? (
    items.map(({ post, href }) => (
      <article class="entry">
        <p class="entry-date">{fmt(post.data.date)}</p>
        <h2 class="entry-title"><a href={href}>{post.data.title}</a></h2>
      </article>
    ))
  ) : (
    <p class="log-status">First post coming soon.</p>
  )}

  <p class="follow-label">Follow along</p>
  <p class="socials">
    <a href="/rss.xml">RSS</a><span class="sep" aria-hidden="true">&#183;</span
    ><a href="https://www.youtube.com/@KyleCovan" rel="me">YouTube</a><span class="sep" aria-hidden="true">&#183;</span
    ><a href="https://x.com/kylecovan" rel="me">X</a><span class="sep" aria-hidden="true">&#183;</span
    ><a href="https://www.linkedin.com/in/kylecovan/" rel="me">LinkedIn</a>
  </p>

  <p class="more"><a href="/">Back to kylecovan.com</a></p>

</Base>
