---
/**
 * The writing index. Nav label "Unless the Lord", URL /writing/.
 *
 * The label is expressive and the URL is plain, on purpose: URLs are functional
 * and a person typing one guesses "writing", not a psalm. The name does its work
 * where a name should, on the page.
 *
 * This is a DIRECTORY, so it lists posts rather than reprinting them. A post
 * tagged to a build lives in full on that build's page (see
 * src/pages/builds/[build].astro) and is linked here; an untagged post has its
 * own page. Either way there is exactly one full copy of any text on the site,
 * so nothing here is duplicate content.
 */
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/* Resolve each post's home once. A tagged post lives on its build's page under
   its own id; an untagged one gets /writing/<id>/. */
const items = await Promise.all(
  posts.map(async (p) => {
    const build = p.data.build ? await getEntry(p.data.build) : null;
    return {
      post: p,
      build,
      href: build ? `/builds/${build.id}/#${p.id}` : `/writing/${p.id}/`,
    };
  })
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const title = 'Unless the Lord — Kyle Covan';
const description =
  'Writing by Kyle Covan on faith, technology, and the daily striving.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://kylecovan.com/writing/#page',
      url: 'https://kylecovan.com/writing/',
      name: 'Unless the Lord',
      description: 'Writing on faith, technology, and the daily striving.',
      inLanguage: 'en',
      author: { '@id': 'https://kylecovan.com/#kyle' },
      /* Names and urls below are all rendered on this page as links.
         verify_site.py checks that from the other side. */
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: items.map((it, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: it.post.data.title,
          url: `https://kylecovan.com${it.href}`,
        })),
      },
    },
    {
      '@type': 'Person',
      '@id': 'https://kylecovan.com/#kyle',
      name: 'Kyle Covan',
      url: 'https://kylecovan.com/',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://kylecovan.com/writing/#breadcrumbs',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kyle Covan', item: 'https://kylecovan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Unless the Lord', item: 'https://kylecovan.com/writing/' },
      ],
    },
  ],
};
---
<Base
  title={title}
  description={description}
  path="/writing/"
  current="Unless the Lord"
  jsonLd={jsonLd}
>

  {/* Psalm 127:1a — the first clause only, at Kyle's instruction, so it balances
      Ecclesiastes 11:1 on /builds/. "1a" is the standard citation for the first
      half of a verse. LORD is small-capped because that is how every major
      English translation sets the divine name; only "ord" is wrapped so the
      text stays "Lord" for copy/paste and screen readers. The verse is NOT the
      h1 — see the .epigraph note in site.css. */}
  <header class="masthead-page">
    <p class="epigraph">
      Unless the L<span class="sc">ord</span> builds the house, those who build
      it labor in vain.
    </p>
    <p class="epigraph-cite">Psalm 127:1a, ESV</p>
    <h1>Writing on faith, technology, and the daily striving</h1>
  </header>

  {items.length > 0 ? (
    items.map(({ post, build, href }) => (
      <article class="entry">
        <p class="entry-date">{fmt(post.data.date)}</p>
        <h2 class="entry-title"><a href={href}>{post.data.title}</a></h2>
        {build && <p class="one-liner">On {build.data.name}.</p>}
      </article>
    ))
  ) : (
    <p class="log-status">First post coming soon.</p>
  )}

  <p class="follow-label">Follow along</p>
  <p class="socials">
    <a href="/rss.xml">RSS</a><span class="sep" aria-hidden="true">&#183;</span
    ><a href="https://www.youtube.com/@KyleCovan" rel="me">YouTube</a><span class="sep" aria-hidden="true">&#183;</span
    ><a href="https://x.com/kylecovan" rel="me">X</a><span class="sep" aria-hidden="true">&#183;</span
    ><a href="https://www.linkedin.com/in/kylecovan/" rel="me">LinkedIn</a>
  </p>

  <p class="more"><a href="/">Back to kylecovan.com</a></p>

</Base>
