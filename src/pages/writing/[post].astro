---
/**
 * One page per published post. draft: true stays out of getStaticPaths,
 * so it never becomes a URL. No log/essay visual split — August 24, 2026.
 *
 * new-direction-reflections is draft (August 29); its body still lives in
 * NewDirectionReflections.astro for when it returns. Until then this template
 * is Markdown-only.
 */
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { post: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);

const url = `https://kylecovan.com/writing/${post.id}/`;
const title = `${post.data.title} — Kyle Covan`;
/* Descriptions must be unique per page. There is no excerpt field, so this is
   derived from the title rather than invented — writing marketing copy for
   Kyle's posts would violate §6 as surely as rewriting the posts would. */
const description = `${post.data.title}. Writing by Kyle Covan on faith, technology, and the daily striving.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${url}#post`,
      url,
      headline: post.data.title,
      datePublished: iso(post.data.date),
      inLanguage: 'en',
      /* The share card, and this is the ONE claim on the page that is not
         backed by something a visitor sees — so it needs its justification
         written down. Google's Article guidance wants a representative image,
         and `Base.astro` already declares this exact file as `og:image` and
         `twitter:image` for this page. Naming it here says the same thing to a
         third parser; it does not invent a new claim. Any other value would,
         because these posts carry no images.

         FIFTH REFERENCE TO `og-2.png`. The other four are in `Base.astro` (x2)
         and `index.astro` (x2). The filename is versioned and MUST change every
         time the picture does — a stale card URL is cached forever by iMessage,
         Slack, X and LinkedIn — so a version bump has to sweep five places now,
         not four. CLAUDE.md's count was updated in the same commit. The real fix
         is one shared constant; that is a deliberate refactor, not a drive-by. */
      image: 'https://kylecovan.com/og-2.png',
      author: { '@id': 'https://kylecovan.com/#kyle' },
      publisher: { '@id': 'https://kylecovan.com/#kyle' },
    },
    {
      '@type': 'Person',
      '@id': 'https://kylecovan.com/#kyle',
      name: 'Kyle Covan',
      url: 'https://kylecovan.com/',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kyle Covan', item: 'https://kylecovan.com/' },
        { '@type': 'ListItem', position: 2, name: 'In Your Sight', item: 'https://kylecovan.com/writing/' },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
      ],
    },
  ],
};
---
<Base
  title={title}
  description={description}
  path={`/writing/${post.id}/`}
  ogType="article"
  current="In Your Sight"
  jsonLd={jsonLd}
>

  <header class="masthead-page">
    <p class="entry-date">{fmt(post.data.date)}</p>
    <h1>{post.data.title}</h1>
  </header>

  <Content />

  <p class="more"><a href="/writing/">All writing</a></p>

</Base>
